{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TuneDeck",
  "version": "0.1.0",
  "identifier": "com.lunek.tunedeck",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TuneDeck",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/loonek/TuneDeck/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwQjVFOEE0OEIyNEVFMQpSV1RoVHJKSWlsNExEb1Vvb0ZEcFJZcUdEN0xFMHVWTkprcUVFbDJ6Z2w4Y3Yxb2NuSkhpRWU3SQo="
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
